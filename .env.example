# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# Qdrant: leave URL empty for embedded local storage (data/qdrant_local)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=papers
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REWRITE_MODEL=openai/gpt-oss-20b
# OLLAMA_MODEL=qwen2.5:1.5b
# QDRANT_FORCE_LOCAL=1
# RATE_LIMIT_PER_MIN=20
# MAX_QUERY_CHARS=500

# Auth + per-user limits. Empty API_KEYS = auth OFF (local dev). Format: name:key[:per_minute[:per_day]],...
# Keys must be >= 16 chars, e.g. generate with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# API_KEYS=alice:<key>:30:300,bob:<key>
# USER_RATE_LIMIT_PER_MIN=20
# USER_DAILY_QUOTA=200
# AUTH_FAIL_PER_MIN=10
